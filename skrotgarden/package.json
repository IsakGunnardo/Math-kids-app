{
  "name": "skrotgarden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && node scripts/build-single.mjs",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "gen:assets": "node scripts/gen-assets.mjs",
    "gen:sfx": "node scripts/gen-sfx.mjs",
    "gen": "npm run gen:assets && npm run gen:sfx",
    "gen:prompts": "node scripts/gen-prompts.mjs",
    "import:art": "node scripts/import-art.mjs",
    "apply:art": "node scripts/apply-art.mjs"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/matter-js": "^0.19.8",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.2",
    "vite": "^5.4.21"
  }
}
